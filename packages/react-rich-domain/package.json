    "test:watch": "vitest --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist coverage node_modules",
    "registry:build": "shadcn build"

{
  "name": "@woltz/react-rich-domain",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "http-server -p 3000",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist coverage node_modules",
    "registry:build": "shadcn build"
  },
  "author": "tarcisioandrade",
  "license": "ISC",
  "description": "React Rich Domain Library",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@woltz/rich-domain": "^1.1.0"
  },
  "devDependencies": {
    "shadcn": "^3.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.0.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}

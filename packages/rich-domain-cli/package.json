{
  "name": "@woltz/rich-domain-cli",
  "version": "0.5.0",
  "description": "CLI tools for @woltz/rich-domain - Generate domain entities and interactive studio",
  "type": "module",
  "bin": {
    "rich-domain": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Tarcisio Andrade",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarcisioandrade/rich-domain.git",
    "directory": "packages/rich-domain-cli"
  },
  "bugs": {
    "url": "https://github.com/tarcisioandrade/rich-domain/issues"
  },
  "keywords": [
    "cli",
    "ddd",
    "domain-driven-design",
    "prisma",
    "generator",
    "entity",
    "aggregate",
    "rich-domain",
    "studio",
    "playground"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:studio",
    "build:cli": "tsc",
    "build:studio": "npm run build:studio:server && npm run build:studio:web",
    "build:studio:server": "tsc --project src/studio/server/tsconfig.json",
    "build:studio:web": "cd src/studio/web && npm install && npm run build && copyfiles -u 1 \"dist/**/*\" ../../../dist/studio/web/dist",
    "dev": "tsc --watch",
    "dev:studio": "node dist/index.js studio",
    "dev:studio:server": "tsx watch src/studio/dev-server.ts",
    "dev:studio:web": "cd src/studio/web && npm run dev",
    "dev:studio:all": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:studio:server\" \"npm run dev:studio:web\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "tsc --noEmit",
    "lint": "echo 'No linting rules defined'",
    "clean": "rm -rf dist node_modules src/studio/web/node_modules",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.1",
    "@prisma/internals": "^6.1.0",
    "@woltz/rich-domain-events-tracker": "^0.1.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.0",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "vm2": "^3.9.19"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/prompts": "^2.4.9",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "name": "@woltz/rich-domain-cli",
  "version": "0.1.1",
  "description": "CLI tools for @woltz/rich-domain - Generate domain entities from Prisma schema",
  "type": "module",
  "bin": {
    "rich-domain": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Tarcisio Andrade",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tarcisioandrade/rich-domain.git",
    "directory": "packages/rich-domain-cli"
  },
  "bugs": {
    "url": "https://github.com/tarcisioandrade/rich-domain/issues"
  },
  "keywords": [
    "cli",
    "ddd",
    "domain-driven-design",
    "prisma",
    "generator",
    "entity",
    "aggregate",
    "rich-domain"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "tsc --noEmit",
    "lint": "echo 'No linting rules defined'",
    "clean": "rm -rf dist node_modules",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "@prisma/internals": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

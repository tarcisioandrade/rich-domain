{
  "name": "@woltz/rich-domain",
  "version": "1.9.3",
  "description": "Rich Domain Library with Standard Schema validation support",
  "homepage": "https://woltz.mintlify.app",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    }
  },
  "author": "Tarcisio Andrade",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/tarcisioandrade/rich-domain/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tarcisioandrade/rich-domain.git",
    "directory": "packages/rich-domain"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types && npm run postbuild",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "postbuild": "node postbuild.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "tsc -b --noEmit",
    "coverage": "jest --coverage",
    "lint": "eslint src",
    "clean": "rm -rf dist coverage node_modules *.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "format": "prettier --write ."
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "entity",
    "aggregate",
    "value-object",
    "validation",
    "standard-schema",
    "typescript"
  ],
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

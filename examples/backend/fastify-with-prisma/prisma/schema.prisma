// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("users")
}

model Post {
  id           String    @id @default(uuid())
  title        String
  main_content String
  published    Boolean   @default(false)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tagPosts     TagPost[]

  @@map("posts")
}

model TagPost {
  tagId  String
  postId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([tagId, postId])
}

model Tag {
  id       String    @id // TagName
  tagPosts TagPost[]

  @@map("tags")
}

model Task {
  id             String   @id @default(uuid())
  title          String
  description    String
  status         String
  priority       String
  assignee       String
  labels         String[]
  order          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedStageAt DateTime

  @@unique([status, order])
  @@map("tasks")
}

{
  "name": "fastify-with-prisma",
  "version": "1.0.0",
  "description": "Fastify project with DDD, Prisma, and Zod",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "echo 'no linting available'",
    "clean": "rm -rf dist coverage node_modules",
    "check": "tsc -b --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "fastify",
    "ddd",
    "prisma",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^5.22.0",
    "@woltz/rich-domain": "^1.8.9",
    "@woltz/rich-domain-criteria-zod": "^0.1.5",
    "@woltz/rich-domain-prisma": "^0.7.7",
    "bullmq": "^5.64.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "fractional-indexing": "^3.2.0",
    "ioredis": "^5.6.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/bun": "latest",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

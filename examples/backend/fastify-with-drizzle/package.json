{
  "name": "fastify-with-drizzle",
  "version": "1.0.0",
  "description": "Fastify project with DDD, Drizzle ORM, and Zod",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc -b --noEmit",
    "clean": "rm -rf dist coverage node_modules",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "echo 'no linting available'"
  },
  "keywords": [
    "fastify",
    "ddd",
    "drizzle",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@woltz/rich-domain": "^1.8.8",
    "@woltz/rich-domain-criteria-zod": "^0.1.5",
    "@woltz/rich-domain-drizzle": "*",
    "bullmq": "^5.64.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

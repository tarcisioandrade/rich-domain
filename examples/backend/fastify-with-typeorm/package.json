{
  "name": "fastify-with-typeorm",
  "version": "1.0.0",
  "description": "Fastify project with DDD, Typeorm, and Zod",
  "main": "dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "echo 'no linting available'",
    "clean": "rm -rf dist coverage node_modules",
    "check": "tsc -b --noEmit",
    "start:worker": "bun tsx watch src/worker.ts"
  },
  "keywords": [
    "fastify",
    "ddd",
    "typeorm",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@woltz/rich-domain": "^1.8.6",
    "@woltz/rich-domain-criteria-zod": "^0.1.5",
    "@woltz/rich-domain-typeorm": "^0.1.5",
    "bullmq": "^5.64.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.16.3",
    "typeorm": "^0.3.28",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

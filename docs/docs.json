{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rich Domain",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "banner": {

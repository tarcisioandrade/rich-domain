                "group":"Quickstart",
                "expanded": false,
                "pages": [
                  "quickstart/default",
                  "quickstart/prisma",
                  "quickstart/typeorm"
                ]
              },
              "CLI"
            ]
          },
          {
            "group": "Core Concepts",
            "icon": "layers",
            "pages": [
              "core/entities-and-aggregates",
              "core/value-objects",
              "core/change-tracking",
              "core/id",
              "core/domain-events"
            ]
          },
          {
            "group": "Validation",
            "icon": "badge-check",
            "pages": [
              "validation/overview",
              "validation/lifecycle-hooks",
              "validation/error-handling"
            ]
          },
         {
            "group": "Criteria",
           "icon": "list-filter",
            "pages": [
              "criteria/overview",
              "criteria/filters",
              "criteria/ordering",
              "criteria/advanced"
            ]
          },
          {
            "group": "Repository",
            "icon":"database",
            "pages": [
              "repository/overview",
              "repository/mappers",
              "repository/schema-registry",
              "repository/paginated-result"
            ]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "pages": [
              "integrations/csv-export",
              "integrations/prisma",
              "integrations/typeorm",
              "integrations/zod",
              "integrations/react",
              "integrations/drizzle"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "github",
      "label": "Get Started",
      "href": "https://github.com/tarcisioandrade/rich-domain"
    },
    "links": []
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "latex": false
